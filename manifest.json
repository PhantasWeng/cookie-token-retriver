{
  "manifest_version": 3,
  "name": "Cookie Token Retriever",
  "version": "1.1.0",
  "description": "Track and one-click copy the cookies / tokens you care about, per domain.",
  "permissions": ["cookies", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Token Retriever"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
